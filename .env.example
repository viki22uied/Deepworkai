# Deep Work AI — .env
# Copy this file, fill in your values, save as .env in the project root.
# All tokens are optional — the system degrades gracefully without them.

# ── Slack (for Focus Shield DND + Meeting Mode) ──────────────────────────────
# Get from: https://api.slack.com/apps → OAuth & Permissions → Bot Token
SLACK_TOKEN=xoxp-your-token-here

# ── GitHub (for Blocker Radar: CI status, PR count, branch health) ───────────
# Get from: https://github.com/settings/tokens → classic → repo + notifications
GITHUB_TOKEN=ghp_your_token_here
# Format: owner/reponame  (e.g. vigneshnair/my-api)
GITHUB_REPO=your-org/your-repo

# ── Jira (optional — for notification interceptor) ───────────────────────────
# JIRA_EMAIL=you@company.com
# JIRA_TOKEN=your-atlassian-api-token
# JIRA_URL=https://yourcompany.atlassian.net
